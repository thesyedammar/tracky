# Tracky helper — environment file. Copy to .env and fill in. NEVER commit .env.

# The shared route: every source below inherits these unless it overrides them.
JEV_BASE_URL=https://opencode.ai/zen/v1/systemone
JEV_MODEL=jev-1.13
JEV_API_KEY=replace-me

# --- Where Jev comes from (this is the extension's dropdown) ------------------
# A comma list of source ids; the FIRST one is the default. Each id inherits the
# three values above and may override them with JEV_PROVIDER_<ID>_BASE_URL /
# _MODEL / _KEY. _LABEL is what the dropdown shows; _KIND (free|paid) is a hint.
# A source whose key is blank appears in the dropdown as "not configured".
#
# zen-free is the same model as zen-paid, on opencode's limited-time free window;
# when that window is closed the helper says so (429 + the minutes to wait).
JEV_PROVIDERS=zen-paid,zen-free,typesafe
JEV_PROVIDER_ZEN_PAID_LABEL=OpenCode Zen · Jev 1.13 (paid)
JEV_PROVIDER_ZEN_PAID_MODEL=jev-1.13
JEV_PROVIDER_ZEN_FREE_LABEL=OpenCode Zen · Jev 1.13 (free window)
JEV_PROVIDER_ZEN_FREE_MODEL=jev-1.13-free
# TypeSafe AI direct — needs your own key from console.typesafe.ai ($5 free credit):
JEV_PROVIDER_TYPESAFE_LABEL=TypeSafe AI (direct)
JEV_PROVIDER_TYPESAFE_MODEL=jev-latest
JEV_PROVIDER_TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_PROVIDER_TYPESAFE_KEY=

# Optional:
# PORT=4199
# TRACKY_ACCESS_TOKEN=   # require clients to send this token (only needed if the helper ever listens beyond localhost)
