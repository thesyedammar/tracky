# Sleuth helper — environment file. Copy to .env and fill in. NEVER commit .env.

# Route A (default — free development route, proven in the Asli project):
#   JEV_BASE_URL=https://opencode.ai/zen/v1/systemone
#   JEV_MODEL=jev-1.13-free
# Route B (official TypeSafe key; $5 free signup credit at console.typesafe.ai):
#   JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
#   JEV_MODEL=jev-latest

JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_API_KEY=replace-me

# Optional:
# PORT=4199
# SLEUTH_ACCESS_TOKEN=   # require clients to send this token (only needed if the helper ever listens beyond localhost)
